# ==============================================================================
# SupportFlow AI — Environment Variables Template
# Copy this file to `.env` for local development (`cp .env.example .env`).
# NEVER commit `.env` with real credentials to version control.
# ==============================================================================

# PostgreSQL + pgvector Configuration
POSTGRES_DB=supportflow
POSTGRES_USER=supportflow
POSTGRES_PASSWORD=change_me_local_postgres_password
POSTGRES_PORT=5432

# Spring Boot Backend Configuration
SERVER_PORT=8080
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/supportflow
SPRING_DATASOURCE_USERNAME=supportflow
SPRING_DATASOURCE_PASSWORD=change_me_local_postgres_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true

# JWT Authentication (Must be a >= 256-bit Base64-encoded secret key)
# Generate one via: openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=U3VwcG9ydEZsb3dBSURldk9ubHlKd3RTZWNyZXRLZXlNdXN0QmVSZXBsYWNlZEluUHJvZHVjdGlvbjI1NkJpdHM=
JWT_EXPIRATION_MS=3600000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
